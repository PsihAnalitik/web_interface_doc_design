# Copy this file to .env and provide a valid OpenAI API key.
OPENAI_API_KEY=your-api-key-here

# Both notebooks read these values, ensuring indexing and retrieval use the same models.
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Number of nearest summaries passed to the LLM relevance filter.
CASE_FINDER_TOP_K=5
