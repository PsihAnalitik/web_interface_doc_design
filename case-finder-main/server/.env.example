OPENAI_API_KEY=your-api-key-here
# Optional API endpoint. Omit for OpenAI; for AITUNNEL uncomment:
# OPENAI_BASE_URL=https://api.aitunnel.ru/v1/
# Model ID, not an API URL.
OPENAI_LLM_MODEL=gpt-4.1-mini
# Agent factory: separate models; old Case Finder settings above are preserved.
FACTORY_MODEL=qwen3.7-plus
FACTORY_VERDICT_MODEL=qwen3.7-plus
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CASE_FINDER_TOP_K=5

# A JSON object supports one or more Basic Auth users.
API_USERS={"admin":"replace-with-a-strong-password"}
API_PORT=8000

STORAGE_PATH=/app/storage
# Original uploads copied here survive job deletion. Empty disables the archive.
DOCUMENTS_ARCHIVE_PATH=/app/documents
TRAIN_CASES_PATH=/app/data/train/files
TRAIN_INDEX_PATH=/app/data/train/train_index.csv

MAX_FILES=10
MAX_FILE_SIZE_MB=20
MAX_TOTAL_UPLOAD_SIZE_MB=100
MAX_QUESTION_COUNT=50
OPENAI_TIMEOUT_SECONDS=120
