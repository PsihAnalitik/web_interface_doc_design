# Copy to agent_factory_baseline/.env. The Python CLI loads the three API settings below.
# Existing environment variables take precedence; shell expansion is not performed.
OPENAI_API_KEY=
# Optional: your configured OpenAI-compatible server, including a local LLM endpoint.
OPENAI_BASE_URL=
# Required for live run: exact model identifier supported by your server.
BASELINE_MODEL=
# Optional: export these in your shell (used by run.sh before Python starts).
WORKFLOW_AI_PATH=
WORKFLOW_AI_PYTHON=
